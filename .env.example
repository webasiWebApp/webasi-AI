# Copy to .env and fill in. Never commit the real .env: it holds live credentials.

# --- Core ---
NODE_ENV=development
PORT=3000
# Signs the dashboard session cookie. Required in production. Use a long random string.
JWT_SECRET=
# The PIN that unlocks the dashboard. Required in production: without it the server answers 503 except /healthz and /api/keepalive.
DASHBOARD_PIN=
# DEPRECATED and ignored (the PIN lock replaced the HTTP Basic password). Remove it from your environment.
# DASHBOARD_PASSWORD=

# --- Database (Supabase) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_RPM_LIMIT=5
GEMINI_DAILY_CAP=500
GROQ_API_KEY=
WEBASI_ENABLED=true
WEBASI_LLM_MODEL=
FAQ_ENGLISH_FOR_SINGLISH=false

# --- WhatsApp ---
WHATSAPP_TRANSPORT=baileys
BAILEYS_PHONE_NUMBER=
BAILEYS_SESSION_ENCRYPTION_KEY=
BAILEYS_RATE_LIMIT_PER_MINUTE=8
WHATSAPP_MONTHLY_CAP=900
# Only for WHATSAPP_TRANSPORT=cloud (Meta Cloud API)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_OWNER_WA_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v26.0

# --- Limits and retention ---
API_RATE_LIMIT_PER_MINUTE=240
AI_RATE_LIMIT_PER_MINUTE=20
HANDOVER_REMINDER_HOURS=2
EVENT_LOG_RETENTION_DAYS=0
MESSAGE_RETENTION_DAYS=0

# --- Google Calendar sync (optional, free; the built-in calendar works without it) ---
# The service account's JSON key, base64-encoded:  base64 -w0 service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=
# The calendar to write to (its address or ID). Share that calendar with the service account's e-mail with "Make changes to events".
GOOGLE_CALENDAR_ID=
