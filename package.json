{
  "name": "webasi-dashboard",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node api.js && cross-env NODE_ENV=development tsx watch server/_core/index.ts",
    "build": "node api.js && cross-env NODE_ENV=production vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "node api.js && cross-env NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "eval": "tsx scripts/eval-engine.ts"
  },
